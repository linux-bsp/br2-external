#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin

PWATCHDOGD_SERVICE=/etc/init.d/S98pwatchdogd
HEALTHCHECK=/usr/sbin/fw-healthcheck
DEBUG_MODE_MARKER=/run/debugctl.active

# Start order. Debug mode stops the same services in reverse order.
MANAGED_SERVICES="
/etc/init.d/S10pdm
/etc/init.d/S50ptelemetryd
/etc/init.d/S51psatellited
"

require_root()
{
	if [ "$(id -u)" -ne 0 ]; then
		echo "debugctl: root privileges are required" >&2
		return 1
	fi
}

run_service()
{
	service=$1
	action=$2

	if [ ! -x "$service" ]; then
		echo "debugctl: service is missing or not executable: $service" >&2
		return 1
	fi

	"$service" "$action"
}

start_services()
{
	for service in $MANAGED_SERVICES; do
		run_service "$service" start || return 1
	done
}

stop_services()
{
	reverse_services=

	for service in $MANAGED_SERVICES; do
		reverse_services="$service $reverse_services"
	done
	for service in $reverse_services; do
		run_service "$service" stop || return 1
	done
}

enter_debug_mode()
{
	if ! : >"$DEBUG_MODE_MARKER"; then
		echo "debugctl: cannot create $DEBUG_MODE_MARKER" >&2
		return 1
	fi

	# K3 RTI is nowayout; keep its feeder alive while health gating is bypassed.
	if ! run_service "$PWATCHDOGD_SERVICE" start; then
		rm -f "$DEBUG_MODE_MARKER"
		return 1
	fi
	stop_services || return 1
	echo "debugctl: debug mode active; watchdog feeding continues"
}

exit_debug_mode()
{
	run_service "$PWATCHDOGD_SERVICE" start || return 1
	start_services || return 1

	if [ ! -x "$HEALTHCHECK" ]; then
		echo "debugctl: health check is missing or not executable: $HEALTHCHECK" >&2
		return 1
	fi
	if ! "$HEALTHCHECK"; then
		echo "debugctl: services restored but health check failed" >&2
		return 1
	fi

	rm -f "$DEBUG_MODE_MARKER"
	echo "debugctl: debug mode inactive; health monitoring restored"
}

status_mode()
{
	if [ -e "$DEBUG_MODE_MARKER" ]; then
		echo "debugctl: debug mode active"
	else
		echo "debugctl: debug mode inactive"
	fi

	for service in $MANAGED_SERVICES; do
		run_service "$service" status || true
	done
	run_service "$PWATCHDOGD_SERVICE" status || true
}

usage()
{
	echo "PAF debug mode controller"
	echo
	echo "Usage: $0 COMMAND"
	echo
	echo "Commands:"
	echo "  start    Enter debug mode: bypass health gating and stop PAF"
	echo "  stop     Exit debug mode: restore PAF and health monitoring"
	echo "  status   Show debug mode and managed service status"
	echo "  help     Show this help"
}

case "$1" in
	help|-h|--help)
		usage
		exit 0
		;;
esac

require_root || exit 1

case "$1" in
	start)
		enter_debug_mode
		;;
	stop)
		exit_debug_mode
		;;
	status)
		status_mode
		;;
	*)
		usage >&2
		exit 2
		;;
esac
