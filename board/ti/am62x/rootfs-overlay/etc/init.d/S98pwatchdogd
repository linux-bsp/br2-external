#!/bin/sh

DAEMON=/usr/bin/pwatchdogd
PIDFILE=/var/run/pwatchdogd.pid

[ -r /etc/default/pwatchdogd ] && . /etc/default/pwatchdogd

running()
{
	[ -r "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null
}

start()
{
	if [ ! -x "$DAEMON" ]; then
		echo "pwatchdogd: $DAEMON is not executable" >&2
		return 1
	fi
	if running; then
		echo "pwatchdogd: already running"
		return 0
	fi

	printf 'Starting pwatchdogd: '
	if [ -n "${PWATCHDOGD_HEALTHCHECK:-}" ]; then
		start-stop-daemon -S -q -b -m \
			-O "${PWATCHDOGD_OUTPUT:-/dev/console}" \
			-p "$PIDFILE" -x "$DAEMON" -- \
			--health-check "$PWATCHDOGD_HEALTHCHECK"
	else
		start-stop-daemon -S -q -b -m \
			-O "${PWATCHDOGD_OUTPUT:-/dev/console}" \
			-p "$PIDFILE" -x "$DAEMON"
	fi
	status=$?
	if [ "$status" -eq 0 ]; then
		# start-stop-daemon only confirms that the child was forked. Check
		# that it survives initialization so a missing PDM device is fatal.
		sleep 1
		if running; then
			echo "OK"
		else
			rm -f "$PIDFILE"
			echo "FAIL (daemon exited during initialization)" >&2
			return 1
		fi
	else
		echo "FAIL"
	fi
	return "$status"
}

stop()
{
	printf 'Stopping pwatchdogd: '
	if running; then
		start-stop-daemon -K -q -p "$PIDFILE" -x "$DAEMON"
		status=$?
	else
		status=0
	fi
	rm -f "$PIDFILE"
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop
		start
		;;
	status)
		if running; then
			echo "pwatchdogd: running pid $(cat "$PIDFILE")"
		else
			echo "pwatchdogd: stopped"
			exit 3
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload|status}" >&2
		exit 2
		;;
esac
