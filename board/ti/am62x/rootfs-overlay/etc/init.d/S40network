#!/bin/sh

interface_present()
{
	[ -d "/sys/class/net/$1" ]
}

start_interface()
{
	iface=$1

	if ! interface_present "$iface"; then
		echo "${iface}: not present; skipping"
		return 0
	fi

	if /sbin/ifup "$iface" >/dev/console 2>&1; then
		echo "${iface}: static configuration applied"
		return 0
	fi

	echo "${iface}: failed to apply static configuration" >&2
	return 1
}

stop_interface()
{
	iface=$1
	interface_present "$iface" || return 0
	/sbin/ifdown "$iface"
}

case "$1" in
	start)
		printf "Starting network: "
		status=0
		start_interface eth0 || status=1
		start_interface eth1 || status=1
		if [ "$status" -eq 0 ]; then
			echo "OK"
		else
			echo "FAIL"
			exit 1
		fi
		;;
	stop)
		printf "Stopping network: "
		status=0
		stop_interface eth0 || status=1
		stop_interface eth1 || status=1
		if [ "$status" -eq 0 ]; then
			echo "OK"
		else
			echo "FAIL"
			exit 1
		fi
		;;
	restart|reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}" >&2
		exit 2
		;;
esac

exit 0
