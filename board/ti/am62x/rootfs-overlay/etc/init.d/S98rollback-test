#!/bin/sh

MARKER=/run/fw-rollback-test.active
FWCTL_CONFIG=/etc/fwctl.conf

cmdline_value()
{
	key=$1
	for argument in $(cat /proc/cmdline); do
		case "$argument" in
			"$key"=*)
				printf '%s\n' "${argument#*=}"
				return 0
				;;
		esac
	done
	return 1
}

deployment_is_confirmed()
{
	deployment=$1
	status=$(/usr/sbin/fwctl --config "$FWCTL_CONFIG" status 2>/dev/null) ||
		return 1
	printf '%s\n' "$status" |
		grep -q "^deployment ${deployment}: .* successful=1 "
}

start()
{
	rm -f "$MARKER"
	test_enabled=$(cmdline_value fw.rollback_test)
	[ "$test_enabled" = "1" ] || return 0

	deployment=$(cmdline_value fw.deployment)
	if [ -n "$deployment" ] && deployment_is_confirmed "$deployment"; then
		echo "fw-rollback-test: deployment $deployment is already confirmed; not blocking"
		return 0
	fi

	printf '%s\n' \
		"fw-rollback-test: armed for deployment ${deployment:-unknown}" \
		"fw-rollback-test: service is blocked; waiting for watchdog reset"
	touch "$MARKER"

	while :; do
		sleep 3600
	done
}

case "$1" in
	start)
		start
		;;
	stop)
		rm -f "$MARKER"
		;;
	restart|reload)
		rm -f "$MARKER"
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}" >&2
		exit 2
		;;
esac

exit 0
