#!/bin/sh

[ -r /etc/default/fwctl ] && . /etc/default/fwctl

PIDFILE=${FWCTL_MARK_GOOD_PIDFILE:-/var/run/fw-mark-good.pid}
OUTPUT=${FWCTL_MARK_GOOD_OUTPUT:-/dev/console}

health_check()
{
	[ -z "${FWCTL_HEALTHCHECK:-}" ] || sh -c "$FWCTL_HEALTHCHECK"
}

wait_until_stable()
{
	checks=${FWCTL_HEALTH_CHECKS:-1}
	interval=${FWCTL_HEALTH_INTERVAL_SEC:-0}
	count=0

	while [ "$count" -lt "$checks" ]; do
		[ "$interval" -eq 0 ] || sleep "$interval"
		if ! health_check; then
			echo "fwctl: health check failed; deployment remains pending" >&2
			return 1
		fi
		count=$((count + 1))
	done

	return 0
}

deployment_is_confirmed()
{
	deployment=$1
	status=$(/usr/sbin/fwctl \
		--config "${FWCTL_CONFIG:-/etc/fwctl.conf}" status 2>/dev/null) ||
		return 1
	printf '%s\n' "$status" |
		grep -q "^deployment ${deployment}: .* successful=1 "
}

worker_running()
{
	[ -r "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	case "$pid" in
		''|*[!0-9]*) return 1 ;;
	esac
	kill -0 "$pid" 2>/dev/null
}

record_mark_good_failure()
{
	failure_file=${FWCTL_BOOT_FAILURES:-/run/rcS.failed}
	failure="S99fw-mark-good:1"
	grep -qx "$failure" "$failure_file" 2>/dev/null ||
		printf '%s\n' "$failure" >> "$failure_file"
}

mark_good_worker()
{
	deployment=$1
	trap 'rm -f "$PIDFILE"' EXIT
	trap 'exit 0' HUP INT TERM

	wait_until_stable || return 0
	if deployment_is_confirmed "$deployment"; then
		echo "fwctl: deployment $deployment is already confirmed"
		return 0
	fi
	if /usr/sbin/fwctl \
		--config "${FWCTL_CONFIG:-/etc/fwctl.conf}" \
		mark-good; then
		echo "fwctl: current deployment marked good"
		return 0
	fi

	echo "fwctl: failed to confirm current deployment" >&2
	record_mark_good_failure
	return 1
}

start_worker()
{
	deployment=$1

	if worker_running; then
		echo "fwctl: deployment health monitoring is already running"
		return 0
	fi
	rm -f "$PIDFILE"

	"$0" worker "$deployment" >"$OUTPUT" 2>&1 &
	worker_pid=$!
	if ! printf '%s\n' "$worker_pid" > "$PIDFILE"; then
		kill "$worker_pid" 2>/dev/null
		echo "fwctl: failed to create background worker pid file" >&2
		return 1
	fi
	if ! kill -0 "$worker_pid" 2>/dev/null; then
		rm -f "$PIDFILE"
		echo "fwctl: failed to start deployment health monitoring" >&2
		return 1
	fi

	echo "fwctl: deployment $deployment health monitoring started in background"
	return 0
}

stop_worker()
{
	if worker_running; then
		pid=$(cat "$PIDFILE")
		kill "$pid" 2>/dev/null || true
	fi
	rm -f "$PIDFILE"
}

case "$1" in
	start)
		[ "${AUTO_MARK_GOOD:-0}" = "1" ] || exit 0
		deployment=$(sed -n 's/.*fw\.deployment=\([01]\).*/\1/p' /proc/cmdline)
		[ -n "$deployment" ] || exit 0
		if deployment_is_confirmed "$deployment"; then
			echo "fwctl: deployment $deployment is already confirmed"
			exit 0
		fi
		start_worker "$deployment"
		;;
	stop)
		stop_worker
		;;
	restart|reload)
		stop_worker
		"$0" start
		;;
	worker)
		case "$2" in
			0|1) mark_good_worker "$2" ;;
			*) exit 2 ;;
		esac
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}" >&2
		exit 2
		;;
esac

exit 0
