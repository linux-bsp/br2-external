#!/bin/sh

DAEMON=/usr/bin/ptelemetryd
CONFIG=/etc/paf/ptelemetryd.conf
PIDFILE=/run/ptelemetryd.pid
OUTPUT=/var/log/ptelemetryd-service.log

running()
{
	[ -r "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	case "$pid" in
		''|*[!0-9]*) return 1 ;;
	esac
	kill -0 "$pid" 2>/dev/null
}

start()
{
	printf 'Starting ptelemetryd: '
	if [ ! -x "$DAEMON" ]; then
		echo "SKIP (not installed)"
		return 0
	fi
	if running; then
		echo "already running"
		return 0
	fi
	rm -f "$PIDFILE"
	"$DAEMON" -c "$CONFIG" >"$OUTPUT" 2>&1 &
	pid=$!
	if ! printf '%s\n' "$pid" >"$PIDFILE" || ! kill -0 "$pid" 2>/dev/null; then
		rm -f "$PIDFILE"
		echo "FAIL"
		return 1
	fi
	echo "OK"
}

stop()
{
	printf 'Stopping ptelemetryd: '
	if running; then
		pid=$(cat "$PIDFILE")
		kill "$pid" 2>/dev/null || true
		count=0
		while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 5 ]; do
			sleep 1
			count=$((count + 1))
		done
		if kill -0 "$pid" 2>/dev/null; then
			kill -9 "$pid" 2>/dev/null || true
		fi
	fi
	rm -f "$PIDFILE"
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop && start ;;
	status)
		if running; then
			echo "ptelemetryd: running pid $(cat "$PIDFILE")"
		else
			echo "ptelemetryd: stopped"
			exit 3
		fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload|status}" >&2
		exit 2
		;;
esac
